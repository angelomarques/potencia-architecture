{
  "name": "potencia-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Potencia web boilerplate — Next.js App Router + feature packs (auth, orpc, turnstile, d1, redis, posthog).",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "SKIP_ENV_VALIDATION=true next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "create": "node scripts/scaffold.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "doctor": "bash .cursor/skills/verify-potencia-stack/scripts/doctor.sh",
    "smoke": "bash .cursor/skills/verify-potencia-stack/scripts/smoke.sh",
    "test:e2e": "playwright test",
    "verify:doctor": "bash .cursor/skills/verify-potencia-stack/scripts/doctor.sh",
    "verify:smoke": "bash .cursor/skills/verify-potencia-stack/scripts/smoke.sh",
    "test:qa-bypass": "SKIP_ENV_VALIDATION=true tsx --test src/lib/auth/qa-bypass.test.ts",
    "qa-bypass:token": "node scripts/qa-bypass-token.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@orpc/client": "^1.10.0",
    "@orpc/server": "^1.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@upstash/redis": "^1.35.0",
    "better-auth": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "posthog-js": "^1.260.0",
    "posthog-node": "^4.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
