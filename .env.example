# Core
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Potencia App
SKIP_ENV_VALIDATION=

# ── auth (pack: auth) ──
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── turnstile (pack: turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── d1 (pack: d1) — Cloudflare D1 HTTP API from Vercel ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# ── redis (pack: redis) — prefer Upstash Marketplace on Vercel ──
# Vercel KV REST aliases (Marketplace Upstash):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or classic Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# ── posthog (pack: posthog) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── cf-cron / cf-queues (OFF by default — only when pack enabled) ──
# CLOUDFLARE_ACCOUNT_ID already above
# CF_QUEUE_NAME=
# CRON_SECRET=
