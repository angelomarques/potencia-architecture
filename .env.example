# Core
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Potencia App
# Base URL for the internal axios client (src/lib/http/internal.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=

# ── posthog event namespace (set uniquely per app on mint; template default: app) ──
# Examples: kingdom-movies → km, potencia-dashboard → pd
NEXT_PUBLIC_EVENT_PREFIX=app

# ── auth (pack: auth) ──
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── turnstile (pack: turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional QA bypass master secret (openssl rand -hex 32). Unset = disabled.
QA_BYPASS_SECRET=

# ── d1 (pack: d1) — Cloudflare D1 HTTP API from Vercel ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
# Set to disabled when this app shares another app's D1 (potencia-products pattern).
# pnpm db:migrate and pnpm db:push then refuse to run. Unset = this app owns the database.
# DB_MIGRATIONS=disabled

# ── redis (pack: redis) — prefer Upstash Marketplace on Vercel ──
# Vercel KV REST aliases (Marketplace Upstash):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or classic Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# ── posthog (pack: posthog) — shared project OK; events are prefixed ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── cf-cron / cf-queues (OFF by default — only when pack enabled) ──
# CLOUDFLARE_ACCOUNT_ID already above
# CF_QUEUE_NAME=
# CRON_SECRET=
